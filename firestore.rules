rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function isAdmin() { return signedIn() && myProfile().get('role', '') == 'admin'; }
    function isApproved() { return signedIn() && (isAdmin() || myProfile().get('status', '') == 'approved'); }
    function isRetailUser() { return isApproved() && myProfile().get('role', '') == 'retail_shop_user'; }
    function newOwnShop() { return request.resource.data.get('shopId', '') == myProfile().get('shopId', ''); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.get('role', '') == 'user' && request.resource.data.get('status', '') == 'pending');
      allow update, delete: if isAdmin();
    }

    match /sharedData/dailyHisab/products/{productId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }
    match /sharedData/dailyHisab/retailShops/{shopId} {
      allow read: if isApproved() && (isAdmin() || !isRetailUser() || shopId == myProfile().get('shopId', ''));
      allow create, update, delete: if isAdmin();
    }
    match /sharedData/dailyHisab/parties/{partyId} {
      allow read: if isApproved();
      allow create: if isAdmin() || (isRetailUser() && request.resource.data.get('createdBy', '') == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /sharedData/dailyHisab/{document=**} {
      allow read: if isApproved() && (isAdmin() || !isRetailUser() || resource.data.get('shopId', '') == myProfile().get('shopId', '') || resource.data.get('retailShopId', '') == myProfile().get('shopId', ''));
      allow create: if isApproved() && request.resource.data.get('createdBy', '') == request.auth.uid && request.resource.data.get('deletionRequested', false) == false && (!isRetailUser() || newOwnShop());
      allow update: if isAdmin()
        || (isApproved() && !isRetailUser() && resource.data.get('deletionRequested', false) != true && request.resource.data.get('deletionRequested', false) == true && request.resource.data.get('deletionRequestedBy', '') == request.auth.uid && request.resource.data.get('deletionRequestedByEmail', '') == request.auth.token.email && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') && request.resource.data.get('createdByEmail', '') == resource.data.get('createdByEmail', '') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionRequested','deletionRequestedBy','deletionRequestedByEmail','updatedAt']))
        || (isRetailUser() && resource.data.get('shopId', '') == myProfile().get('shopId', '') && request.resource.data.get('shopId', '') == myProfile().get('shopId', '') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionRequested','deletionRequestedBy','deletionRequestedByEmail','updatedAt']));
      allow delete: if isAdmin();
    }

    // Change Approvals are Admin-only. Explicit get/list rules make the query path unambiguous.
    match /changeRequests/{requestId} {
      allow create: if isApproved() && request.resource.data.get('requestedBy', '') == request.auth.uid && request.resource.data.get('status', '') == 'pending' && request.resource.data.get('action', '') in ['edit', 'delete'];
      allow get: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
      allow list: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
      allow update, delete: if signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    match /deletionRequests/{requestId} {
      allow create: if isApproved() && request.resource.data.get('requestedBy', '') == request.auth.uid && request.resource.data.get('status', '') == 'pending';
      allow read, update, delete: if isAdmin();
    }
  }
}
