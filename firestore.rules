rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && profile().role == 'admin'; }
    function isApproved() { return signedIn() && (profile().role == 'admin' || profile().status == 'approved'); }
    function isRetailUser() { return isApproved() && profile().role == 'retail_shop_user'; }
    function ownShop() { return profile().shopId != null && profile().shopId != ''; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.role == 'user' && request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    match /sharedData/dailyHisab/products/{productId} {
      allow read: if isApproved();
      allow create, update, delete: if isAdmin();
    }
    match /sharedData/dailyHisab/retailShops/{shopId} {
      allow read: if isApproved() && (isAdmin() || !isRetailUser() || shopId == profile().shopId);
      allow create, update, delete: if isAdmin();
    }
    match /sharedData/dailyHisab/{document=**} {
      allow read: if isApproved() && (isAdmin() || !isRetailUser() || resource.data.get('shopId','') == profile().shopId || resource.data.get('retailShopId','') == profile().shopId);
      allow create: if isApproved() && request.resource.data.get('createdBy','') == request.auth.uid && request.resource.data.get('deletionRequested',false) == false && (!isRetailUser() || request.resource.data.get('shopId','') == profile().shopId);
      allow update: if isAdmin()
        || (isApproved() && !isRetailUser() && resource.data.get('deletionRequested',false) != true && request.resource.data.get('deletionRequested',false) == true && request.resource.data.get('deletionRequestedBy','') == request.auth.uid && request.resource.data.get('deletionRequestedByEmail','') == request.auth.token.email && request.resource.data.get('createdBy','') == resource.data.get('createdBy','') && request.resource.data.get('createdByEmail','') == resource.data.get('createdByEmail','') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionRequested','deletionRequestedBy','deletionRequestedByEmail','updatedAt']))
        || (isRetailUser() && resource.data.get('shopId','') == profile().shopId && request.resource.data.get('shopId','') == profile().shopId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletionRequested','deletionRequestedBy','deletionRequestedByEmail','updatedAt']));
      allow delete: if isAdmin();
    }

    match /changeRequests/{requestId} {
      allow create: if isApproved() && request.resource.data.requestedBy == request.auth.uid && request.resource.data.status == 'pending' && request.resource.data.action in ['edit','delete'];
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
    match /deletionRequests/{requestId} {
      allow create: if isApproved() && request.resource.data.requestedBy == request.auth.uid && request.resource.data.status == 'pending';
      allow read, update, delete: if isAdmin();
    }
  }
}
